{%- props
    ## string Unique identifier used to generate the drawer's ids.
    id,
    ## boolean Whether the drawer is open on initial render.
    open = false,
    ## boolean Whether the drawer is modal (page inert, focus trapped, backdrop) or sits beside the page.
    modal = true,
    ## 'left'|'right'|'top'|'bottom' The side of the viewport the drawer is docked to.
    placement = 'left'
-%}
{#- drop every attribute named on…: behavior goes through data-action, never an inline handler -#}
{%- set attributes = attributes.without(...attributes.all|keys|filter((name) => (name ~ '')|trim("\x00..\x20", 'left')|lower starts with 'on')) -%}
{%- set _drawer_id = 'drawer-' ~ id -%}
{%- set _drawer_title_id = _drawer_id ~ '-title' -%}
{%- set _drawer_placement = placement -%}
<div
    data-drawer-open-value="{{ open ? 'true' : 'false' }}"
    data-drawer-modal-value="{{ modal ? 'true' : 'false' }}"
    {{ attributes.defaults({'data-controller': 'drawer'}) }}
>
    {##- The drawer structure: `Drawer:Trigger` and `Drawer:Content`. -#}
    {%- block content %}{% endblock -%}
</div>
