{%- props
    ## string The branch's label, also its accessible name.
    label,
    ## string|null The name its open state is saved under, unique among its sibling branches; defaults to the label.
    name = null,
    ## boolean Whether the branch renders open; a branch holding the current page (`aria-current="page"`) renders open anyway, and the controller then restores the state saved during the visit.
    open = false
-%}
{#- the attributes given, in any case: no `on…` handler, `srcset` or `ping`; `href` and `formaction` through the link policy, `src` through the image policy -#}
{%- set attributes = attributes.without(...attributes.all|keys).defaults(attributes.all|filter((value, name) => not ((name ~ '')|trim("\x00..\x20", 'left')|lower matches '/^(?:on|(?:srcset|ping)$)/'))|map((value, name) => (name ~ '')|trim("\x00..\x20", 'left')|lower not in ['href', 'formaction', 'src'] or value is null or value is same as(false) or value is same as(true) ? value : ((value ~ '')|replace({"\t": '', "\n": '', "\r": ''})|trim("\x00..\x20", 'left') matches ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? '/^(?:https?:|(?![a-z][a-z0-9+.-]*:))/i' : '/^(?:(?:https?|mailto|tel):|(?![a-z][a-z0-9+.-]*:))/i') ? value ~ '' : ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? null : '#')))) -%}
{%- set _content %}{##- The branch's children: `SideNav:Item`s and nested `SideNav:Branch`es. -#}{% block content %}{% endblock %}{% endset -%}
{%- set _icon %}{##- The branch's icon, kept visible when a `Sidebar` around the tree is collapsed. -#}{% block icon %}{% endblock %}{% endset -%}
{%- set _open = open or 'aria-current="page"' in _content -%}
<li role="treeitem" aria-label="{{ label }}" aria-expanded="{{ _open ? 'true' : 'false' }}" tabindex="-1"
    data-side-nav-target="branch" data-side-nav-name="{{ name ?? label }}"
    {{ attributes.defaults({class: 'focus:outline-none'|tailwind_classes}) }}>
    <span data-side-nav-toggle class="flex min-h-11 cursor-pointer select-none items-center gap-3 rounded-base px-2 font-medium text-body hover:bg-neutral-secondary-medium hover:text-heading [:focus-visible>&]:ring-2 [:focus-visible>&]:ring-brand-medium" aria-hidden="true">
        {%- if _icon|trim is not empty %}
            <span class="inline-flex size-5 shrink-0 items-center justify-center">{{ _icon }}</span>
        {%- endif %}
        <span class="min-w-0 flex-1 truncate group-data-collapsed/sidebar:sr-only">{{ label }}</span>
        <twig:ux:icon name="flowbite:chevron-right-outline" class="size-4 shrink-0 transition-transform motion-reduce:transition-none! group-data-collapsed/sidebar:hidden [[aria-expanded=true]>*>&]:rotate-90" />
    </span>
    <ul role="group" class="ms-4.5 mt-1 space-y-1 border-s border-default ps-2 group-data-collapsed/sidebar:hidden [[aria-expanded=false]>&]:hidden">
        {{- _content -}}
    </ul>
</li>
