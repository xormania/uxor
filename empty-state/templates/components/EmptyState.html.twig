{%- props
    ## string The headline saying what is empty.
    title,
    ## string|null What to do about it.
    description = null
-%}
{#- drop every attribute named on…: behavior goes through data-action, never an inline handler -#}
{%- set attributes = attributes.without(...attributes.all|keys|filter((name) => (name ~ '')|trim("\x00..\x20", 'left')|lower starts with 'on')) -%}
<div {{ attributes.defaults({class: 'flex flex-col items-center px-6 py-10 text-center'|tailwind_classes}) }}>
    <div class="mb-4 flex size-12 items-center justify-center rounded-full bg-neutral-tertiary text-body">
        {##- An icon illustrating the empty content. -#}
        {%- block icon %}<twig:ux:icon name="flowbite:inbox-outline" class="size-6" aria-hidden="true" />{% endblock -%}
    </div>
    <h2 class="text-lg font-semibold text-heading">{{ title }}</h2>
    {%- if description %}
        <p class="mt-1 max-w-sm text-sm text-body">{{ description }}</p>
    {%- endif %}
    <div class="mt-6 flex flex-wrap justify-center gap-3 empty:hidden">
        {##- The actions leading out of the empty state, typically a button. -#}
        {%- block actions %}{% endblock -%}
    </div>
</div>
