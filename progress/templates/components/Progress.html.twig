{%- props
    ## int|float The progress, from 0 to 100.
    value = 0,
    ## string|null The visible label, which also names the progress bar.
    label = null,
    ## bool Whether the percentage is shown next to the label.
    showValue = false,
    ## 'brand'|'success'|'danger'|'warning' The color of the bar.
    variant = 'brand',
    ## 'sm'|'default'|'lg' The height of the bar.
    size = 'default',
    ## boolean Whether the bar shows a measure (a share, a quota) rather than the progress of a task: `role="meter"`.
    meter = false
-%}
{#- the attributes given, in any case: no `on…` handler, `srcset` or `ping`; `href` and `formaction` through the link policy, `src` through the image policy -#}
{%- set attributes = attributes.without(...attributes.all|keys).defaults(attributes.all|filter((value, name) => not ((name ~ '')|trim("\x00..\x20", 'left')|lower matches '/^(?:on|(?:srcset|ping)$)/'))|map((value, name) => (name ~ '')|trim("\x00..\x20", 'left')|lower not in ['href', 'formaction', 'src'] or value is null or value is same as(false) or value is same as(true) ? value : ((value ~ '')|replace({"\t": '', "\n": '', "\r": ''})|trim("\x00..\x20", 'left') matches ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? '/^(?:https?:|(?![a-z][a-z0-9+.-]*:))/i' : '/^(?:(?:https?|mailto|tel):|(?![a-z][a-z0-9+.-]*:))/i') ? value ~ '' : ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? null : '#')))) -%}
{#- cast to a number: the value ends up in the bar's width attribute -#}
{%- set _value = max(0, min(100, value|round(2))) -%}
{%- set track = html_cva(
    base: 'w-full overflow-hidden rounded-full bg-neutral-primary ring-1 ring-default ring-inset',
    variants: {size: {sm: 'h-1.5', default: 'h-2.5', lg: 'h-4'}},
) -%}
{%- set bar = html_cva(
    base: 'block h-full rounded-full',
    variants: {variant: {brand: 'bg-brand', success: 'bg-success', danger: 'bg-danger', warning: 'bg-warning'}},
) -%}
{%- set _label_id = label ? 'progress-' ~ random() : null -%}
{#- the progressbar element, not the wrapper, carries the accessible name -#}
{%- set _aria_label = attributes.render('aria-label') -%}
{%- set _aria_labelledby = attributes.render('aria-labelledby') -%}
<div {{ attributes.defaults({class: 'w-full'|tailwind_classes}) }}>
    {%- if label %}
        <div class="mb-1 flex justify-between text-sm font-medium text-heading">
            <span id="{{ _label_id }}">{{ label }}</span>
            {%- if showValue %}<span>{{ _value|round }}%</span>{% endif %}
        </div>
    {%- endif %}
    <div role="{{ meter ? 'meter' : 'progressbar' }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ _value }}"{% if _label_id or _aria_labelledby %} aria-labelledby="{{ _label_id ?: _aria_labelledby }}"{% elseif _aria_label %} aria-label="{{ _aria_label }}"{% endif %} class="{{ track.apply({size: size}) }}">
        {#- an empty SVG sized by its width attribute, not a style attribute, which a Content Security Policy restricting styles blocks -#}
        <svg width="{{ _value }}%" aria-hidden="true" class="{{ bar.apply({variant: variant}) }}"></svg>
    </div>
</div>
