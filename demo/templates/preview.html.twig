{# Same page as symfony/ux apps/toolkit/templates/preview.html.twig, with this app's importmap entrypoint and Content Security Policy nonces. #}
<!DOCTYPE html>
<html lang="en" class="{{ theme == 'dark' ? 'dark' }}" data-bs-theme="{{ theme }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ title }}</title>
        {#- an example alone, shown inside its recipe's page: that page is the one to find -#}
        <meta name="robots" content="noindex">
        <link rel="icon" href="data:,">
        <meta name="csp-nonce" nonce="{{ csp_style_nonce }}">
        <style nonce="{{ csp_style_nonce }}">
            body {
                {% if is_block %}
                    display: block; margin: 0; width: 100%;
                {% else %}
                    display: flex; align-items: center; justify-content: center; margin: 0; width: 100%; padding: 48px; min-height: 200px;
                {% endif %}
            }
        </style>
        {{ importmap('app', {nonce: csp_script_nonce ~ ''}) }}
    </head>
    <body>{{ html|raw }}</body>
</html>
