{% extends 'base.html.twig' %}

{% block title %}dropzone-options ({{ page }}) — Lab{% endblock %}

{% block body %}
    {{ include('lab/_header.html.twig', {name: 'dropzone-options'}) }}
    <h2 class="mb-2 text-lg font-semibold" data-testid="page">Page {{ page }}</h2>
    <p class="mb-4"><a href="{{ path('app_lab_dropzone_options', {page: page == 'one' ? 'two' : 'one'}) }}" class="text-fg-brand hover:underline">Go to page {{ page == 'one' ? 'two' : 'one' }}</a></p>
    <div class="mb-6 grid max-w-3xl gap-6 md:grid-cols-2">
        {#- maxFiles renders the cap on the wrapper with `multiple` and a positive integer only -#}
        <twig:FormField for="capped" label="Two files at most">
            <twig:Dropzone id="capped" name="capped[]" multiple maxFiles="2" />
        </twig:FormField>
        <twig:FormField for="capped-images" label="Two images at most">
            <twig:Dropzone id="capped-images" name="capped_images[]" multiple maxFiles="2" accept="image/png,image/jpeg" />
        </twig:FormField>
        {#- `preview_item`: the item markup only, one root element; the component wraps it in the template target -#}
        <twig:FormField for="templated" label="Templated file">
            <twig:Dropzone id="templated" name="templated">
                <twig:block name="preview_item">
                    <div class="flex w-full items-center gap-3" data-testid="templated-item">
                        <img class="size-12 rounded-sm" alt="" data-dropzone-slot="image">
                        <strong class="flex-1 text-sm text-heading" data-dropzone-slot="filename"></strong>
                        <button type="button" class="rounded-base p-1 text-body" data-dropzone-slot="remove"><twig:ux:icon name="flowbite:close-outline" class="size-4" aria-hidden="true" /></button>
                    </div>
                </twig:block>
            </twig:Dropzone>
        </twig:FormField>
        <twig:FormField for="templated-list" label="Templated files">
            <twig:Dropzone id="templated-list" name="templated_list[]" multiple>
                <twig:block name="preview_item">
                    <li class="flex items-center gap-3" data-testid="templated-list-item">
                        <strong class="flex-1 text-sm text-heading" data-dropzone-slot="filename"></strong>
                        <button type="button" class="rounded-base p-1 text-body" data-dropzone-slot="remove"><twig:ux:icon name="flowbite:close-outline" class="size-4" aria-hidden="true" /></button>
                    </li>
                </twig:block>
            </twig:Dropzone>
        </twig:FormField>
    </div>
    {#- a POST form holds the user's work: its templated zone keeps its file after Back -#}
    <form method="post" action="{{ path('app_lab_dropzone_options', {page: page}) }}" enctype="multipart/form-data" class="mb-6 max-w-sm">
        <twig:FormField for="templated-post" label="Templated file in a POST form">
            <twig:Dropzone id="templated-post" name="templated_post">
                <twig:block name="preview_item">
                    <div class="flex w-full items-center gap-3" data-testid="templated-post-item">
                        <strong class="flex-1 text-sm text-heading" data-dropzone-slot="filename"></strong>
                        <button type="button" class="rounded-base px-2 text-sm text-body" data-dropzone-slot="remove">×</button>
                    </div>
                </twig:block>
            </twig:Dropzone>
        </twig:FormField>
    </form>
    {% if upload %}
        {#- `?form=1`: a DropzoneType whose files show through the form theme's `dropzone_preview_item` block -#}
        {% if posted %}<p class="mb-2 text-sm text-heading" data-testid="posted">posted={{ posted }}</p>{% endif %}
        {% form_theme upload 'lab/_dropzone_options_theme.html.twig' %}
        {{ form_start(upload, {attr: {class: 'mb-6 max-w-sm', 'data-testid': 'templated-form'}}) }}
            {{ form_row(upload.document) }}
            <twig:Button type="submit" class="mt-4">Send the document</twig:Button>
        {{ form_end(upload) }}
    {% endif %}
    <form method="post" action="{{ path('app_lab_dropzone_options', {page: page}) }}" class="mb-4 flex gap-3">
        <twig:Button type="submit" name="action" value="replace" variant="secondary">Replace the templated zone</twig:Button>
        <twig:Button type="submit" name="action" value="update" variant="secondary">Update the templated zone</twig:Button>
    </form>
    <div id="dropzone-options-region" class="max-w-sm">{{ include('lab/_dropzone_options_streamed.html.twig') }}</div>
{% endblock %}
