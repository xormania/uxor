{% extends 'base.html.twig' %}

{% block title %}tooltip-stream — Lab{% endblock %}

{% block body %}
    {{ include('lab/_header.html.twig', {name: 'tooltip-stream'}) }}
    <form method="post" action="{{ path('app_lab_tooltip_stream') }}" class="mb-4 flex gap-3">
        <twig:Button type="submit" name="action" value="replace" variant="secondary">Replace the tooltip</twig:Button>
        <twig:Button type="submit" name="action" value="update" variant="secondary">Update the tooltip</twig:Button>
    </form>
    <div id="tooltip-region" class="pt-12">{{ include('lab/_tooltip_streamed.html.twig') }}</div>
{% endblock %}
