{% extends 'base.html.twig' %}

{% block title %}drawer-stream — Lab{% endblock %}

{% block body %}
    {{ include('lab/_header.html.twig', {name: 'drawer-stream'}) }}
    <form method="post" action="{{ path('app_lab_drawer_stream') }}" class="mb-4 flex gap-3">
        <twig:Button type="submit" name="action" value="replace" variant="secondary">Replace the drawer</twig:Button>
        <twig:Button type="submit" name="action" value="update" variant="secondary">Update the drawer</twig:Button>
    </form>
    <div id="drawer-region">{{ include('lab/_drawer_streamed.html.twig') }}</div>
{% endblock %}
