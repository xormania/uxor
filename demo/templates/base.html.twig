{#- Set by app:export-static on the pages it saves for GitHub Pages: {release, latest_release, commit}; null when served by Symfony. -#}
{%- set static_export = app.request.attributes.get('_static_export') -%}
{%- set repository = kit_reader.manifest.homepage -%}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ kit_reader.manifest.name }} demo{% endblock %}</title>
        <meta name="description" content="Flowbite 4 and Tailwind CSS 4 components, layouts, blocks and a form theme for the Symfony UX Toolkit, with all behavior in Stimulus controllers.">
        <link rel="icon" href="data:,">
        {# The request's Content Security Policy nonces, as the layouts recipe prints them (Turbo gives this one to the <style> of its progress bar). #}
        <meta name="csp-nonce" nonce="{{ csp_style_nonce }}">
        {# No-flash theme snippet from the theme-toggle recipe README: sets the theme before the first paint. #}
        <script nonce="{{ csp_script_nonce }}">
            try {
                const theme = localStorage.getItem('theme');
                document.documentElement.classList.toggle('dark', 'dark' === theme || ('light' !== theme && matchMedia('(prefers-color-scheme: dark)').matches));
            } catch (e) {}
        </script>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app', {nonce: csp_script_nonce ~ ''}) }}{% endblock %}
        {% endblock %}
    </head>
    {#- form_reset: false on a lab page composed without the layouts recipe's form-reset controller (/lab/autocomplete?bare=1) -#}
    <body{% if form_reset ?? true %} data-controller="form-reset"{% endif %} class="flex min-h-screen flex-col bg-neutral-primary text-body antialiased">
        <header class="border-b border-default bg-neutral-primary">
            <nav class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3" aria-label="Main">
                <a href="{{ path('app_index') }}" class="flex items-center gap-2 font-semibold text-heading">
                    <span class="xor-logo xor-glow size-7 shrink-0 rounded-base" aria-hidden="true"></span>
                    {{ kit_reader.manifest.name }}
                </a>
                <a href="{{ path('app_index') }}#recipes" class="text-sm font-medium hover:text-heading">Recipes</a>
                <a href="{{ path('app_demo') }}" class="text-sm font-medium hover:text-heading">Demo app</a>
                {% if not static_export %}
                    <a href="{{ path('app_forms') }}" class="text-sm font-medium hover:text-heading">Forms</a>
                    <a href="{{ path('app_lab') }}" class="text-sm font-medium hover:text-heading">Lab</a>
                {% endif %}
                <div class="ml-auto flex items-center gap-4">
                    <a href="{{ repository }}" class="text-sm font-medium hover:text-heading">GitHub</a>
                    <twig:ThemeToggle />
                </div>
            </nav>
        </header>
        {% if static_export %}
            <div class="border-b border-default bg-neutral-secondary-medium text-sm">
                <p class="mx-auto max-w-7xl px-4 py-2">
                    {% if static_export.release -%}
                        A static copy of the demo at release <strong class="text-heading">{{ static_export.release }}</strong>.
                    {%- else -%}
                        A static copy of the demo, built from
                        {% if static_export.commit %}<a href="{{ repository }}/commit/{{ static_export.commit }}" class="font-mono underline hover:text-heading">{{ static_export.commit[:7] }}</a> on {% endif %}<code>main</code>
                        {%- if static_export.latest_release %} after release <strong class="text-heading">{{ static_export.latest_release }}</strong>{% endif %}.
                    {%- endif %}
                    Live Components, Turbo Streams and form submits need Symfony:
                    <a href="{{ repository }}/blob/main/CONTRIBUTING.md#setup" class="underline hover:text-heading">run the full demo</a>.
                </p>
            </div>
        {% endif %}
        {% block hero %}{% endblock %}
        <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8">
            {% block body %}{% endblock %}
        </main>
        <footer class="border-t border-default">
            <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-6 text-sm">
                <p>MIT licensed.</p>
                <a href="{{ repository }}/blob/main/README.md" class="underline hover:text-heading">README</a>
                <a href="{{ repository }}/blob/main/CHANGELOG.md" class="underline hover:text-heading">Changelog</a>
                <a href="{{ repository }}/releases" class="underline hover:text-heading">Releases</a>
                <a href="{{ repository }}/blob/main/SECURITY.md" class="underline hover:text-heading">Security</a>
            </div>
        </footer>
    </body>
</html>
