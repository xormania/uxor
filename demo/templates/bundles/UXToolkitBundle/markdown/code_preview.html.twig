{#- An example's preview: the gallery's preview page (App\Kit\ExamplePreviewUrls) in both themes, as the recipe page shows it -#}
{%- if previewUrl %}
    <div class="grid overflow-hidden rounded-base border border-default md:grid-cols-2" data-testid="doc-preview">
        {%- for theme in ['light', 'dark'] %}
            <figure class="{{ loop.first ? 'md:border-r' : 'border-t md:border-t-0' }} border-default">
                <iframe src="{{ previewUrl }}?theme={{ theme }}" title="Preview ({{ theme }})" loading="lazy"
                        data-controller="preview-frame" class="block h-72 w-full"></iframe>
                <figcaption class="border-t border-default px-4 py-1.5 text-xs">{{ theme|capitalize }}</figcaption>
            </figure>
        {%- endfor %}
    </div>
{%- else %}
    <pre tabindex="0" class="overflow-x-auto rounded-base bg-neutral-secondary-medium p-4 text-sm text-heading"><code>{{ code }}</code></pre>
{%- endif %}
