{% extends 'base.html.twig' %}

{% block title %}Form theme parity — {{ kit_reader.manifest.name }} demo{% endblock %}

{% macro first_error(field) %}{{ (field.vars.errors|first).message }}{% endmacro %}

{% block body %}
    {% from _self import first_error %}
    <h1 class="text-2xl font-bold">Form theme parity</h1>
    <p class="mt-2 mb-6 text-body">Left: rows rendered by the form theme from a submitted Symfony form. Right: the same rows written by hand with the components. Playwright compares each pair pixel for pixel.</p>
    <div class="grid grid-cols-[24rem_24rem] gap-8">
        <h2 class="font-semibold">Form theme</h2>
        <h2 class="font-semibold">Components</h2>

        <div data-pair="name" data-side="theme">{{ form_row(form.name) }}</div>
        <div data-pair="name" data-side="components">
            <twig:FormField for="c_name" label="Name" help="As it appears on your invoices." :error="[first_error(form.name)]" required class="mb-6">
                <twig:Input type="text" id="c_name" name="c_name" value="A" required aria-describedby="c_name_help c_name_error" aria-invalid="true" />
            </twig:FormField>
        </div>

        <div data-pair="email" data-side="theme">{{ form_row(form.email) }}</div>
        <div data-pair="email" data-side="components">
            <twig:FormField for="c_email" label="Email" :error="[first_error(form.email)]" required class="mb-6">
                <twig:Input type="email" id="c_email" name="c_email" placeholder="name@example.com" required aria-describedby="c_email_error" aria-invalid="true" />
            </twig:FormField>
        </div>

        <div data-pair="country" data-side="theme">{{ form_row(form.country) }}</div>
        <div data-pair="country" data-side="components">
            <twig:FormField for="c_country" label="Country" :error="[first_error(form.country)]" required class="mb-6">
                <twig:Select id="c_country" name="c_country" required aria-describedby="c_country_error" aria-invalid="true">
                    <option value="" selected>Choose a country</option>
                    <option value="fr">France</option>
                    <option value="de">Germany</option>
                    <option value="jp">Japan</option>
                    <option value="us">United States</option>
                </twig:Select>
            </twig:FormField>
        </div>

        <div data-pair="bio" data-side="theme">{{ form_row(form.bio) }}</div>
        <div data-pair="bio" data-side="components">
            <twig:FormField for="c_bio" label="Bio" help="At most 200 characters." class="mb-6">
                <twig:Textarea id="c_bio" name="c_bio" rows="3" aria-describedby="c_bio_help">Designer in Lyon.</twig:Textarea>
            </twig:FormField>
        </div>

        <div data-pair="photo" data-side="theme">{{ form_row(form.photo) }}</div>
        <div data-pair="photo" data-side="components">
            <twig:FormField for="c_photo" label="Photo" help="PNG or JPG, up to 1 MB." class="mb-6">
                <twig:Dropzone id="c_photo" name="c_photo" accept="image/png,image/jpeg" placeholder="Drop a photo or browse" aria-describedby="c_photo_help" />
            </twig:FormField>
        </div>

        <div data-pair="startsOn" data-side="theme">{{ form_row(form.startsOn) }}</div>
        <div data-pair="startsOn" data-side="components">
            <twig:FormField for="c_startsOn" label="Starts on" help="The first day of your subscription." class="mb-6">
                <twig:DatePicker id="c_startsOn_picker" selected="2026-03-12" class="block w-full">
                    <div class="flex gap-2">
                        <twig:DatePicker:Input>
                            <twig:Input id="c_startsOn" aria-describedby="c_startsOn_help" {{ ...date_picker_input_attrs }} />
                        </twig:DatePicker:Input>
                        <twig:DatePicker:Trigger>
                            <twig:Button variant="outline" size="icon" aria-label="Choose date" {{ ...date_picker_trigger_attrs }}>
                                <twig:ux:icon name="flowbite:calendar-month-outline" class="size-5" aria-hidden="true" />
                            </twig:Button>
                        </twig:DatePicker:Trigger>
                    </div>
                    <twig:DatePicker:Content>
                        <twig:Calendar name="c_startsOn" selected="2026-03-12" month="2026-03-12" minDate="2026-01-01" />
                    </twig:DatePicker:Content>
                </twig:DatePicker>
            </twig:FormField>
        </div>

        <div data-pair="plan" data-side="theme">{{ form_row(form.plan) }}</div>
        <div data-pair="plan" data-side="components">
            <twig:FormField as="fieldset" for="c_plan" label="Plan" help="You can change it later." :error="[first_error(form.plan)]" required class="mb-6" aria-describedby="c_plan_help c_plan_error">
                <div id="c_plan" class="space-y-3">
                    {% for value, name in {free: 'Free', pro: 'Pro', team: 'Team'} %}
                        <div class="flex items-center gap-2">
                            <twig:Radio id="c_plan_{{ value }}" name="c_plan" value="{{ value }}" required />
                            <twig:Label for="c_plan_{{ value }}" class="select-none">{{ name }}</twig:Label>
                        </div>
                    {% endfor %}
                </div>
            </twig:FormField>
        </div>

        <div data-pair="terms" data-side="theme">{{ form_row(form.terms) }}</div>
        <div data-pair="terms" data-side="components">
            <twig:FormField for="c_terms" :error="[first_error(form.terms)]" class="mb-6">
                <div class="flex items-center gap-2">
                    <twig:Checkbox id="c_terms" name="c_terms" value="1" required aria-describedby="c_terms_error" aria-invalid="true" />
                    <twig:Label for="c_terms" variant="invalid" class="select-none">I accept the terms</twig:Label>
                </div>
            </twig:FormField>
        </div>

        <div data-pair="save" data-side="theme">{{ form_row(form.save) }}</div>
        <div data-pair="save" data-side="components">
            <div><twig:Button type="submit" id="c_save" name="c_save">Create account</twig:Button></div>
        </div>
    </div>
{% endblock %}
