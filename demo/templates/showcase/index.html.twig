{% extends 'base.html.twig' %}

{% block title %}{{ kit.manifest.name }}: Flowbite components for Symfony UX{% endblock %}

{% block hero %}
    {%- set example_total = example_counts|reduce((total, count) => total + count, 0) -%}
    <section class="xor-hero dark border-b border-default text-body" aria-labelledby="kit-heading">
        <div class="mx-auto max-w-7xl px-4 pt-16 pb-14 sm:pt-24 sm:pb-20">
            <div class="flex flex-wrap gap-2">
                <twig:Badge variant="brand">Symfony UX Toolkit kit</twig:Badge>
                <twig:Badge variant="gray">Flowbite 4</twig:Badge>
                <twig:Badge variant="gray">Tailwind CSS 4</twig:Badge>
                <twig:Badge variant="gray">Stimulus</twig:Badge>
            </div>
            <h1 id="kit-heading" class="mt-4 text-4xl font-bold tracking-tight text-heading sm:text-5xl">{{ kit.manifest.name }}</h1>
            <p class="mt-4 max-w-xl text-lg">{{ kit.manifest.description }}</p>
            <div class="mt-6 flex flex-wrap gap-3">
                <twig:Button as="a" href="#recipes" size="lg">Browse the recipes</twig:Button>
                <twig:Button as="a" href="#install" variant="secondary" size="lg">Install</twig:Button>
                <twig:Button as="a" href="{{ path('app_demo') }}" variant="tertiary" size="lg">Open the demo app</twig:Button>
            </div>
            <dl class="mt-8 grid max-w-xl grid-cols-[repeat(2,minmax(0,1fr))] gap-4">
                {% for stat in [
                    {value: (groups.component.recipes ?? [])|length, label: 'components'},
                    {value: (groups.block.recipes ?? [])|length, label: 'blocks'},
                    {value: example_total, label: 'live examples'},
                    {value: 2, label: 'themes, light and dark'},
                ] %}
                    <div class="flex flex-col rounded-base border border-default bg-neutral-secondary-soft p-4">
                        <dt class="text-sm">{{ stat.label }}</dt>
                        <dd class="order-first text-2xl font-semibold text-heading">{{ stat.value }}</dd>
                    </div>
                {% endfor %}
            </dl>
        </div>
    </section>
{% endblock %}

{% block body %}
    {%- set static_export = app.request.attributes.get('_static_export') -%}
    {%- set kit_url = kit.manifest.homepage ~ (static_export.release ?? false ? ':' ~ static_export.release : '') -%}
    {%- set example_total = example_counts|reduce((total, count) => total + count, 0) -%}

    <section class="pb-10" aria-labelledby="why-heading">
        <h2 id="why-heading" class="text-2xl font-semibold text-heading">What it gives you</h2>
        <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {% for item in [
                {icon: 'flowbite:fire-outline', title: 'Stimulus only', text: 'Every behavior is a Stimulus controller, no initFlowbite(): components keep working across Turbo visits and Live Component re-renders.'},
                {icon: 'flowbite:lock-outline', title: 'Strict CSP', text: 'No inline script, style or event handler, so the components run under a nonce-based Content Security Policy.'},
                {icon: 'flowbite:moon-outline', title: 'Light and dark', text: 'Flowbite’s color roles for both themes, with contrast fixes checked in CI, and a toggle that remembers the choice.'},
                {icon: 'flowbite:check-circle-outline', title: 'Tested in a browser', text: 'Every example on this site is compared with a screenshot in both themes, and every page passes an axe accessibility scan.'},
            ] %}
                <li class="rounded-base border border-default p-5">
                    <span class="grid size-9 place-items-center rounded-base bg-brand-softer text-fg-brand" aria-hidden="true">{{ ux_icon(item.icon, {class: 'size-5'}) }}</span>
                    <h3 class="mt-4 font-semibold text-heading">{{ item.title }}</h3>
                    <p class="mt-2 text-sm">{{ item.text }}</p>
                </li>
            {% endfor %}
        </ul>
    </section>

    <section id="install" class="scroll-mt-20 border-t border-default py-10" aria-labelledby="install-heading">
        <h2 id="install-heading" class="text-2xl font-semibold text-heading">Install</h2>
        <ol class="mt-6 grid gap-6 lg:grid-cols-2">
            <li>
                <h3 class="font-semibold text-heading">1. Prepare the project, once</h3>
                <p class="mt-1 text-sm">Then set up Tailwind CSS, Flowbite’s stylesheet and the <code>theme</code> recipe: <a href="{{ kit.manifest.homepage }}/blob/main/INSTALL.md" class="underline hover:text-heading">INSTALL.md</a>.</p>
                <pre tabindex="0" class="mt-3 overflow-x-auto rounded-base bg-neutral-secondary-medium p-4 text-sm text-heading"><code>composer config extra.symfony.allow-contrib true
composer require symfony/twig-bundle symfony/ux-twig-component
composer require --dev symfony/ux-toolkit:^3.5 symfony/http-client
composer require symfony/asset-mapper symfony/stimulus-bundle</code></pre>
            </li>
            <li>
                <h3 class="font-semibold text-heading">2. Install the recipes you need</h3>
                <p class="mt-1 text-sm">A recipe brings the recipes it depends on, then prints the packages to require. The <a href="{{ kit.manifest.homepage }}#install" class="underline hover:text-heading">README</a> has the details.</p>
                <pre tabindex="0" class="mt-3 overflow-x-auto rounded-base bg-neutral-secondary-medium p-4 text-sm text-heading"><code>php bin/console ux:install button \
    --kit={{ kit_url }}</code></pre>
            </li>
        </ol>
    </section>

    <section id="recipes" class="scroll-mt-20 border-t border-default py-10" aria-labelledby="recipes-heading">
        <h2 id="recipes-heading" class="text-2xl font-semibold text-heading">Recipes <span class="text-body" data-testid="recipe-count">({{ recipes|length }})</span></h2>
        <p class="mt-2 max-w-3xl">Components are the building blocks; blocks are whole sections of a page made of them. Each recipe page shows every example of its README, in both themes, with its code.</p>
        <div data-testid="recipe-list">
            {% for type, group in groups %}
                <h3 class="mt-8 text-lg font-semibold text-heading">{{ group.title }} <span class="font-normal text-body">({{ group.recipes|length }})</span></h3>
                <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {% for recipe in group.recipes %}
                        <li class="relative flex flex-col rounded-base border border-default p-4 hover:border-brand hover:bg-neutral-secondary-soft">
                            <a href="{{ path('app_recipe', {recipe: recipe.name}) }}" class="font-semibold text-heading after:absolute after:inset-0">{{ recipe.name }}</a>
                            {% if recipe.description %}
                                <p class="mt-1 line-clamp-3 text-sm">{{ recipe.description }}</p>
                            {% endif %}
                            <p class="mt-auto pt-3 text-xs">{{ example_counts[recipe.name] ?: 'No' }} live {{ 1 == example_counts[recipe.name] ? 'example' : 'examples' }}</p>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="mt-4">No recipes yet.</p>
            {% endfor %}
        </div>
    </section>

    <section class="border-t border-default py-10" aria-labelledby="demo-heading">
        <h2 id="demo-heading" class="text-2xl font-semibold text-heading">Put together</h2>
        <p class="mt-2 max-w-3xl">The layouts and blocks as the pages of a small application, the way an app would use them after <code>ux:install</code>.</p>
        <ul class="mt-6 flex flex-wrap gap-3">
            {% for route, label in {app_demo: 'Dashboard', app_demo_login: 'Login', app_demo_signup: 'Sign up', app_demo_forgot_password: 'Forgot password', app_demo_settings_profile: 'Settings', app_demo_blank: 'Blank page'} %}
                <li><twig:Button as="a" href="{{ path(route) }}" variant="outline">{{ label }}</twig:Button></li>
            {% endfor %}
        </ul>
    </section>
{% endblock %}
