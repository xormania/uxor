{% extends 'base.html.twig' %}

{% block title %}{{ recipe.manifest.name }}: {{ kit.manifest.name }}{% endblock %}

{% block description %}{{ (recipe.description ?: recipe.manifest.name)|plain_markdown|raw }}{% endblock %}

{% block body %}
    {%- set static_export = app.request.attributes.get('_static_export') -%}
    {%- set source = kit.manifest.homepage ~ '/tree/' ~ (static_export.commit ?? 'main') ~ '/' ~ recipe.name -%}
    {%- set is_page = 'block' == recipe.manifest.type.value or 'layouts' == recipe.name -%}

    <div class="lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-10">
        <nav class="hidden lg:block" aria-label="Recipes">
            <div class="sticky top-6 max-h-[calc(100vh-3rem)] overflow-y-auto pb-6 text-sm">
                {% for group in groups %}
                    <p class="px-2 font-semibold text-heading {{ loop.first ? '' : 'mt-6' }}">{{ group.title }}</p>
                    <ul class="mt-2 space-y-0.5">
                        {% for item in group.recipes %}
                            <li>
                                {% if item.name == recipe.name %}
                                    <a href="{{ path('app_recipe', {recipe: item.name}) }}" aria-current="page" class="block rounded-base bg-neutral-tertiary-medium px-2 py-1 font-semibold text-heading">{{ item.name }}</a>
                                {% else %}
                                    <a href="{{ path('app_recipe', {recipe: item.name}) }}" class="block rounded-base px-2 py-1 hover:bg-neutral-secondary-medium hover:text-heading">{{ item.name }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endfor %}
            </div>
        </nav>

        <div>
            <nav class="text-sm" aria-label="Breadcrumb">
                <ol class="flex flex-wrap gap-2">
                    <li><a href="{{ path('app_index') }}#recipes" class="underline hover:text-heading">Recipes</a></li>
                    <li aria-hidden="true">/</li>
                    <li><span aria-current="page">{{ recipe.name }}</span></li>
                </ol>
            </nav>
            <div class="mt-3 flex flex-wrap items-center gap-3">
                <h1 class="min-w-0 break-words text-3xl font-bold tracking-tight text-heading">{{ recipe.manifest.name }}</h1>
                <twig:Badge variant="{{ 'block' == recipe.manifest.type.value ? 'warning' : 'brand' }}">{{ recipe.manifest.type.value }}</twig:Badge>
            </div>
            {% if recipe.description %}
                <p class="mt-3 max-w-3xl break-words text-lg">{{ recipe.description|inline_markdown }}</p>
            {% endif %}
            {%- if static_export.server_only[recipe.name] ?? false %}
                {#- set by app:export-static: what of this recipe's examples needs Symfony behind it -#}
                <p class="mt-4 max-w-3xl rounded-base border border-default bg-neutral-secondary-medium px-4 py-3 text-sm" data-testid="server-only">
                    In this static copy, {{ static_export.server_only[recipe.name] }}.
                    <a href="{{ repository }}/blob/main/CONTRIBUTING.md#setup" class="underline hover:text-heading">Run the full demo</a> to try it.
                </p>
            {%- endif %}

            <section class="mt-8 min-w-0" aria-labelledby="installs-heading">
                <h2 id="installs-heading" class="font-semibold text-heading">What it installs</h2>
                <dl class="mt-3 grid grid-cols-[max-content_minmax(0,1fr)] gap-x-6 gap-y-2 text-sm">
                    <dt class="font-medium text-heading">Copies</dt>
                    <dd>
                        {% for source_path, destination in recipe.manifest.copyFiles %}
                            <code>{{ source_path }}</code> → <code>{{ destination }}</code>{% if not loop.last %}<br>{% endif %}
                        {% else %}
                            nothing
                        {% endfor %}
                    </dd>
                    {% if dependencies.recipes %}
                        <dt class="font-medium text-heading">Recipes</dt>
                        <dd class="flex flex-wrap gap-x-3">
                            {% for dependency in dependencies.recipes %}
                                <a href="{{ path('app_recipe', {recipe: dependency.name}) }}" class="underline hover:text-heading">{{ dependency.name }}</a>
                            {% endfor %}
                        </dd>
                    {% endif %}
                    {% for group, label in {composer: 'Composer', npm: 'npm', importmap: 'Importmap'} %}
                        {% if dependencies[group] %}
                            <dt class="font-medium text-heading">{{ label }}</dt>
                            <dd>{% for dependency in dependencies[group] %}<code>{{ dependency }}</code>{% if not loop.last %}<br>{% endif %}{% endfor %}</dd>
                        {% endif %}
                    {% endfor %}
                </dl>
                <p class="mt-3 flex gap-4 text-sm">
                    <a href="{{ source }}/README.md" class="underline hover:text-heading">README</a>
                    <a href="{{ path('app_recipe_markdown', {recipe: recipe.name}) }}" type="text/markdown" class="underline hover:text-heading">Markdown</a>
                    <a href="{{ source }}" class="underline hover:text-heading">Source</a>
                </p>
            </section>

            {#- the README, rendered by the UX Toolkit (App\Kit\RecipeDocs): its prose, its install steps at the
                release this copy shows, its examples as their preview pages, its API tables -#}
            <div class="recipe-doc group/doc mt-10 min-w-0"{{ is_page ? ' data-page' : '' }} data-testid="recipe-doc">
                {{ doc|raw }}
            </div>
        </div>
    </div>
{% endblock %}
