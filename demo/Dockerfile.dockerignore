# The build context of demo/Dockerfile is the repository (compose.override.yaml, the CI lanes), read through this list
# alone (BuildKit takes <Dockerfile>.dockerignore over the context's .dockerignore). Nothing is sent but what is named
# here: the demo, the kit's recipes as the demo reads them (each recipe's manifest, README, templates, assets, PHP and
# config), the root files the gallery reads at run time, and tools/sync-demo, which the production build runs.
#
# How a file is judged: by the last pattern that matches that file's own path, so excluding a directory's name (`.git`,
# `**/.git`) leaves out none of its files that an earlier re-include matches. A pattern names a path, not a type, and
# drops a trailing slash: `!*/config/` re-includes the file .git/config, which is how .git once reached the image.
# Two rules keep that from happening, each enough alone (both checked with tools/tests/prod-image.sh's context part):
# - a re-include below the root starts with a letter or a digit, `![a-z0-9]*/…`, never `!*/…`, so it cannot match a dot
#   directory;
# - every exclusion names the directory and everything below it (`x` and `x/**`), and comes after the re-includes.
# And a third, for a developer's checkout, which holds files a clone never has: every directory is an allow-list,
# demo/ included (`!demo/<entry>`, never `!demo`), so a file nobody named stays out.
*

# the kit as the demo reads it (app.kit_dir: the demo's parent); a recipe's directories are those its copy-files names
!manifest.json
!kit.css
!INSTALL.md
!llms.txt
!LICENSE
!NOTICE
!docs/GUIDE.md
![a-z0-9]*/manifest.json
![a-z0-9]*/README.md
![a-z0-9]*/templates
![a-z0-9]*/assets
![a-z0-9]*/src
![a-z0-9]*/config

# the demo app, as an allow-list too: only what its build and its pages use, so a new file in a developer's demo/
# (a secrets key, a local env or PHPUnit file, an editor's or an agent's folder) stays out by default
!demo/bin
!demo/config
!demo/src
!demo/templates
!demo/assets
!demo/public
!demo/frankenphp
!demo/composer.json
!demo/composer.lock
!demo/symfony.lock
!demo/importmap.php
!demo/.env
# below those, what is installed, generated or local, as demo/.gitignore lists it: the secrets (the demo ships no
# encrypted secret, so the whole directory), Symfony's generated reference, the installed browser packages and bundle
# assets, and every copy tools/sync-demo makes, which the production build makes again from the recipes
demo/config/secrets
demo/config/secrets/**
demo/config/reference.php
demo/config/uxor_oauth.example.yaml
demo/public/assets
demo/public/assets/**
demo/public/bundles
demo/public/bundles/**
demo/assets/vendor
demo/assets/vendor/**
demo/templates/components
demo/templates/components/**
demo/templates/form
demo/templates/form/**
demo/templates/layouts
demo/templates/layouts/**
demo/src/UXor
demo/src/UXor/**
demo/assets/controllers/**
!demo/assets/controllers/csrf_protection_controller.js
!demo/assets/controllers/preview_frame_controller.js
!demo/assets/controllers/dropzone_echo_controller.js
demo/assets/styles/uxor*.css
demo/assets/lib/uxor-*.js
demo/assets/images/uxor-oauth-*
**/*.log
**/.DS_Store

# never, below any re-include above: dot directories (.git, .github…), tests, node packages, the Composer package
.*
.*/**
**/.git
**/.git/**
*/tests
*/tests/**
tests
tests/**
**/node_modules
**/node_modules/**
packages
packages/**

# copies the recipes into the demo at build time (removed from the production image after)
tools
tools/**
!tools/sync-demo
