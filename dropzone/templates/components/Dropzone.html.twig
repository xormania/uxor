{%- props
    ## boolean Whether several files can be chosen: they add up across picks, and each one gets its own Remove button.
    multiple = false,
    ## string|null The main line of the box.
    placeholder = 'Drag and drop or browse',
    ## string|null A second, smaller line, such as "PNG or JPG, up to 2 MB"; the file input is described by it.
    hint = null,
    ## string The name of the Remove buttons, followed by the file name ("Remove photo.png").
    removeLabel = 'Remove',
    ## string|null A note in the box, such as a file that was not kept after a form error; the file input is described by it.
    reselect = null
-%}
{#- the attributes given, in any case: no `on…` handler, `srcset` or `ping`; `href` and `formaction` through the link policy, `src` through the image policy -#}
{%- set attributes = attributes.without(...attributes.all|keys).defaults(attributes.all|filter((value, name) => not ((name ~ '')|trim("\x00..\x20", 'left')|lower matches '/^(?:on|(?:srcset|ping)$)/'))|map((value, name) => (name ~ '')|trim("\x00..\x20", 'left')|lower not in ['href', 'formaction', 'src'] or value is null or value is same as(false) or value is same as(true) ? value : ((value ~ '')|replace({"\t": '', "\n": '', "\r": ''})|trim("\x00..\x20", 'left') matches ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? '/^(?:https?:|(?![a-z][a-z0-9+.-]*:))/i' : '/^(?:(?:https?|mailto|tel):|(?![a-z][a-z0-9+.-]*:))/i') ? value ~ '' : ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? null : '#')))) -%}
{%- set controller = 'symfony--ux-dropzone--dropzone' -%}
{#- `class`, `data-controller`, `data-action` and the attributes of the controllers passed (but their targets) go to the
    wrapper, where UX Dropzone dispatches its events; every other attribute goes to the file input. Pass a stable `id`,
    which the label's `for` names -#}
{%- set _id = attributes.all.id ?? ('dropzone-' ~ random()) -%}
{%- set _own = (attributes.all['data-controller'] ?? '')|split(' ')|filter((name) => name) -%}
{%- set _controllers = ([controller, 'dropzone-assist']|merge(_own))|join(' ') -%}
{%- set _wrapperKeys = ['class']|merge(attributes.all|keys|filter((key) => _own|filter((name) => key starts with ('data-' ~ name ~ '-') and key != ('data-' ~ name ~ '-target'))|length > 0)) -%}
{%- set _actions = 'dragenter->dropzone-assist#dragOver dragover->dropzone-assist#dragOver dragleave->dropzone-assist#dragLeave drop->dropzone-assist#drop change->dropzone-assist#remember:capture dropzone:change->dropzone-assist#changed dropzone:clear->dropzone-assist#cleared dropzone:remove->dropzone-assist#removed turbo:before-cache@document->dropzone-assist#cache' -%}
{%- set _describedby = [attributes.all['aria-describedby'] ?? null, hint ? _id ~ '_hint' : null, reselect ? _id ~ '_reselect' : null]|filter((id) => id)|join(' ') -%}
<div
    {{ attributes.only(..._wrapperKeys).defaults({class: 'group w-full'|tailwind_classes, 'data-controller': _controllers}) }}
    data-symfony--ux-dropzone--dropzone-multiple-value="{{ multiple ? 'true' : 'false' }}"
    data-symfony--ux-dropzone--dropzone-remove-label-value="{{ removeLabel }}"
    data-action="{{ (_actions ~ ' ' ~ (attributes.all['data-action'] ?? ''))|trim }}"
>
    <div class="relative flex min-h-36 w-full items-center justify-center rounded-base border-2 border-dashed border-default-strong bg-neutral-secondary-medium p-4 text-center has-[input:hover:enabled:not([aria-invalid=true])]:bg-neutral-tertiary has-[input:focus-visible]:border-brand has-[input:focus-visible]:ring-2 has-[input:focus-visible]:ring-brand-medium has-[input[aria-invalid=true]]:border-danger-subtle has-[input[aria-invalid=true]]:bg-danger-soft group-data-dragging:border-brand group-data-dragging:bg-brand-softer has-[input:disabled]:cursor-not-allowed has-[input:disabled]:border-default has-[input:disabled]:bg-disabled">
        <input
            {{ attributes.without('data-controller', 'data-action', 'placeholder', 'type', 'id', 'multiple', 'aria-describedby', ..._wrapperKeys) }}
            type="file"
            id="{{ _id }}"
            {%- if multiple %} multiple{% endif %}
            {%- if _describedby %} aria-describedby="{{ _describedby }}"{% endif %}
            class="absolute inset-0 z-10 size-full cursor-pointer opacity-0 disabled:cursor-not-allowed"
            data-symfony--ux-dropzone--dropzone-target="input"
            data-dropzone-assist-target="input"
        >
        <div data-symfony--ux-dropzone--dropzone-target="placeholder" data-dropzone-assist-target="placeholder">
            <div class="flex flex-col items-center gap-2">
                {##- The inside of the box before a pick, above the hint: the icon and the placeholder, for a custom look. -#}
                {%- block content -%}
                    <twig:ux:icon name="flowbite:cloud-arrow-up-outline" class="size-8 text-body group-has-[input:disabled]:text-fg-disabled" aria-hidden="true" />
                    {%- if placeholder %}
                        <p class="text-sm font-semibold text-heading">{{ placeholder }}</p>
                    {%- endif %}
                {%- endblock -%}
                {%- if hint %}
                    <p id="{{ _id }}_hint" class="text-xs text-body">{{ hint }}</p>
                {%- endif %}
                {%- if reselect %}
                    <p id="{{ _id }}_reselect" class="text-sm text-fg-danger-strong">{{ reselect }}</p>
                {%- endif %}
            </div>
        </div>
        {%- if not multiple %}
            <div class="hidden w-full" data-symfony--ux-dropzone--dropzone-target="preview" data-dropzone-assist-target="preview">
                <div class="flex w-full items-center gap-3 text-start">
                    <div class="hidden size-12 shrink-0 rounded-sm bg-contain bg-center bg-no-repeat" aria-hidden="true" data-symfony--ux-dropzone--dropzone-target="previewImage"></div>
                    <span id="{{ _id }}_filename" class="min-w-0 flex-1 text-sm font-medium wrap-anywhere text-heading" data-symfony--ux-dropzone--dropzone-target="previewFilename"></span>
                    <button
                        type="button"
                        class="relative z-20 inline-flex size-8 shrink-0 items-center justify-center rounded-base text-body hover:bg-neutral-tertiary-medium hover:text-heading focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-medium"
                        aria-labelledby="{{ _id }}_remove {{ _id }}_filename"
                        data-symfony--ux-dropzone--dropzone-target="previewClearButton"
                        data-dropzone-assist-target="clearButton"
                        data-action="click->dropzone-assist#clearing:capture"
                    >
                        <span id="{{ _id }}_remove" class="sr-only">{{ removeLabel }}</span>
                        <twig:ux:icon name="flowbite:close-outline" class="size-5" aria-hidden="true" />
                    </button>
                </div>
            </div>
        {%- endif %}
    </div>
    {%- if multiple %}
        <ul class="mt-3 space-y-2 empty:hidden" aria-live="polite" data-symfony--ux-dropzone--dropzone-target="previewList" data-dropzone-assist-target="list" data-action="click->dropzone-assist#removing:capture"></ul>
    {%- endif %}
</div>
