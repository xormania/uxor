{%- props
    ## string Unique suffix identifier for generating Tabs internal IDs.
    value
-%}
{#- drop every attribute named on…: behavior goes through data-action, never an inline handler -#}
{%- set attributes = attributes.without(...attributes.all|keys|filter((name) => (name ~ '')|trim("\x00..\x20", 'left')|lower starts with 'on')) -%}

{%- set _tab_id = (idPrefix ?? 'tab') ~ '-' ~ value -%}
{%- set _tab_content_id = _tab_id ~ '-description' -%}
{%- set open = defaultValue is same as(value) -%}
<div
    id="{{ _tab_content_id }}"
    data-tabs-target="tab"
    data-tab-id="{{ value }}"
    role="tabpanel"
    aria-labelledby="{{ _tab_id }}"
    data-state="{{ open ? 'active' : 'inactive' }}"
    {{ attributes.defaults({
        tabindex: '0',
        class: 'data-[state=inactive]:hidden'|tailwind_classes,
    }) }}
>
    {##- The default block. -#}
    {%- block content %}{% endblock -%}
</div>
