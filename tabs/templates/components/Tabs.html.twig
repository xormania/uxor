{%- props
    ## string Define the open Tabs at initial rendering.
    defaultValue = '',
    ## 'horizontal'|'vertical' Define the visual orientation.
    orientation = 'horizontal',
    ## string The prefix of the tabs' and panels' ids (`<idPrefix>-<value>`); give each Tabs of a page its own when their values repeat.
    idPrefix = 'tab'
-%}
{#- drop every attribute named on…: behavior goes through data-action, never an inline handler -#}
{%- set attributes = attributes.without(...attributes.all|keys|filter((name) => (name ~ '')|trim("\x00..\x20", 'left')|lower starts with 'on')) -%}

<div
    data-controller="tabs"
    data-tabs-active-tab-value="{{ defaultValue }}"
    data-orientation="{{ orientation }}"
    {{ attributes.defaults({
        class: 'gap-4 group/tabs flex data-[orientation=horizontal]:flex-col'|tailwind_classes,
    }) }}
>
    {## The default block. -#}
    {% block content %}{% endblock %}
</div>
