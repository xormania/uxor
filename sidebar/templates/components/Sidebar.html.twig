{%- props
    ## string The sidebar's id: required by `data-turbo-permanent`, and targeted by the `Navbar` toggle.
    id = 'sidebar',
    ## string The accessible name of the navigation.
    label = 'Main',
    ## string The localStorage key of the collapsed state.
    storageKey = 'sidebar-collapsed'
-%}
{#- drop every attribute named on…: behavior goes through data-action, never an inline handler -#}
{%- set attributes = attributes.without(...attributes.all|keys|filter((name) => (name ~ '')|trim("\x00..\x20", 'left')|lower starts with 'on')) -%}
<aside
    id="{{ id }}"
    data-sidebar-storage-key-value="{{ storageKey }}"
    {{ attributes.defaults({
        class: 'group/sidebar flex h-full w-64 shrink-0 flex-col border-e border-default bg-neutral-primary-soft transition-[width] duration-200 motion-reduce:transition-none! data-collapsed:w-16 max-md:not-data-mobile-open:hidden max-md:data-mobile-open:fixed max-md:data-mobile-open:inset-y-0 max-md:data-mobile-open:left-0 max-md:data-mobile-open:z-40 max-md:data-mobile-open:shadow-lg'|tailwind_classes,
        'data-controller': 'sidebar',
        'data-action': 'sidebar:toggle@window->sidebar#toggleMobile keydown.esc->sidebar#closeMobile',
    }) }}
>
    <div class="flex items-center gap-2 px-3 py-3">
        <div class="min-w-0 flex-1 group-data-collapsed/sidebar:hidden">
            {##- The top of the sidebar, typically the brand. -#}
            {%- block header %}{% endblock -%}
        </div>
        <button type="button" data-action="sidebar#toggle" data-sidebar-target="toggle" aria-controls="{{ id }}" aria-expanded="true" aria-label="Collapse sidebar"
                class="inline-flex size-11 shrink-0 items-center justify-center rounded-base text-body hover:bg-neutral-secondary-medium hover:text-heading focus:outline-none focus:ring-2 focus:ring-brand-medium max-md:hidden!">
            <twig:ux:icon name="flowbite:chevron-left-outline" class="size-5 transition-transform motion-reduce:transition-none! group-data-collapsed/sidebar:rotate-180" aria-hidden="true" />
        </button>
    </div>
    <nav aria-label="{{ label }}" data-sidebar-target="scroll" data-action="scroll->sidebar#rememberScroll" class="min-h-0 flex-1 space-y-4 overflow-y-auto px-3 pb-4">
        {##- The navigation: `Sidebar:Group`s holding `Sidebar:Item`s. -#}
        {%- block content %}{% endblock -%}
    </nav>
</aside>
