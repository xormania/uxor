{%- props
    ## Symfony\Component\Form\FormView The registration form; every field renders through the form theme.
    form,
    ## string The card title, the page's `h1`.
    title = 'Create an account',
    ## string The label of the submit button.
    submitLabel = 'Create account',
    ## string|null The link to the login page. A URL other than relative, http(s), mailto or tel renders `#`.
    loginHref = null
-%}
{#- the attributes given, in any case: no `on…` handler, `srcset` or `ping`; `href` and `formaction` through the link policy, `src` through the image policy -#}
{%- set attributes = attributes.without(...attributes.all|keys).defaults(attributes.all|filter((value, name) => not ((name ~ '')|trim("\x00..\x20", 'left')|lower matches '/^(?:on|(?:srcset|ping)$)/'))|map((value, name) => (name ~ '')|trim("\x00..\x20", 'left')|lower not in ['href', 'formaction', 'src'] or value is null or value is same as(false) or value is same as(true) ? value : ((value ~ '')|replace({"\t": '', "\n": '', "\r": ''})|trim("\x00..\x20", 'left') matches ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? '/^(?:https?:|(?![a-z][a-z0-9+.-]*:))/i' : '/^(?:(?:https?|mailto|tel):|(?![a-z][a-z0-9+.-]*:))/i') ? value ~ '' : ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? null : '#')))) -%}
{#- a link prop keeps a relative, http(s), mailto or tel URL, read as browsers read it (case, leading spaces and C0 controls, tabs and newlines anywhere); any other renders "#" -#}
{%- set _login_href = (loginHref ~ '')|replace({"\t": '', "\n": '', "\r": ''})|trim("\x00..\x20", 'left') matches '/^(?:(?:https?|mailto|tel):|(?![a-z][a-z0-9+.-]*:))/i' ? loginHref ~ '' : '#' -%}
{#- the block renders its form through the form-theme recipe, whatever twig.form_themes says -#}
{%- form_theme form 'form/flowbite_layout.html.twig' -%}
<div {{ attributes.defaults({class: 'w-full'|tailwind_classes}) }}>
    <twig:Card>
        <twig:Card:Header>
            <twig:Card:Title as="h1" class="text-xl">{{ title }}</twig:Card:Title>
        </twig:Card:Header>
        <twig:Card:Content>
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <twig:Button type="submit" class="w-full">{{ submitLabel }}</twig:Button>
            {{ form_end(form) }}
        </twig:Card:Content>
        {%- if loginHref %}
            <p class="mt-6 text-center text-sm text-body">Already have an account? <a href="{{ _login_href }}" class="font-medium text-fg-brand underline hover:no-underline">Sign in</a></p>
        {%- endif %}
    </twig:Card>
</div>
