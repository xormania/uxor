<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% set description = description ?? kit.manifest.description %}
    <title>{{ page_title }}</title>
    <meta name="description" content="{{ description }}">
    {% if canonical %}
        <link rel="canonical" href="{{ canonical }}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="{{ kit.manifest.name }}">
        <meta property="og:title" content="{{ page_title }}">
        <meta property="og:description" content="{{ description }}">
        <meta property="og:url" content="{{ canonical }}">
        <meta name="twitter:card" content="summary">
    {% else %}
        <meta name="robots" content="noindex">
    {% endif %}
    {% if markdown_url is defined %}
        <link rel="alternate" type="text/markdown" href="{{ markdown_url }}">
    {% endif %}
    <link rel="icon" href="{{ base_path }}/website-assets/logo.jpg">
    <script src="{{ base_path }}/website-assets/site.js"></script>
    <link rel="stylesheet" href="{{ base_path }}/website-assets/site.css">
    <link rel="stylesheet" href="{{ base_path }}/website-assets/recipe-doc.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="masthead">
    <nav class="wrap main-nav" aria-label="Main">
        <a class="brand" href="{{ path('app_index') }}"><img src="{{ base_path }}/website-assets/logo.jpg" width="28" height="28" alt=""><span>{{ kit.manifest.name }}</span></a>
        <div class="product-nav">
            <a href="{{ path('app_guide', {name: 'composer'}) }}"{% if name|default('') == 'composer' %} aria-current="page"{% endif %}>Composer Dev Package</a>
            <a href="{{ path('app_guide', {name: 'guide'}) }}"{% if name|default('') == 'guide' %} aria-current="page"{% endif %}>UXor Symfony UX Toolkit</a>
        </div>
        <div class="site-nav">
            <a href="{{ path('app_index') }}#guides">Guides</a>
            <a href="{{ path('app_index') }}#recipes">Recipes</a>
            <a href="{{ path('app_demo') }}">Demo app</a>
            <a href="{{ repository }}">GitHub</a>
            <button type="button" class="theme-toggle" aria-label="Toggle dark mode" aria-pressed="false" hidden><span aria-hidden="true">◐</span></button>
        </div>
    </nav>
</header>
<aside class="release-note" aria-label="Version">
    <div class="wrap">
        {% if release %}
            Documentation for release <a href="{{ repository }}/releases/tag/{{ release }}">{{ release }}</a>.
        {% else %}
            Development documentation {% if commit %}at <a href="{{ repository }}/commit/{{ commit }}">{{ commit[:7] }}</a> {% endif %}on <code>{{ branch }}</code>.
            {% if latest_release %}Latest release: <a href="{{ repository }}/releases/tag/{{ latest_release }}">{{ latest_release }}</a>.{% endif %}
        {% endif %}
    </div>
</aside>
<main id="main" tabindex="-1">
    {% block hero %}{% endblock %}
    <div class="wrap content">{% block body %}{% endblock %}</div>
</main>
<footer>
    <nav class="wrap footer-nav" aria-label="Documentation">
        {% for section in guide_sections %}
            <div>
                <p>{{ section.title }}</p>
                <ul>
                    {% for slug, guide in section.guides %}
                        <li><a href="{{ path('app_guide', {name: slug}) }}">{{ guide.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
        <div>
            <p>Project</p>
            <ul>
                <li><a href="{{ repository }}/blob/{{ release ?? 'main' }}/README.md">README</a></li>
                <li><a href="{{ repository }}/blob/{{ release ?? 'main' }}/CHANGELOG.md">Changelog</a></li>
                <li><a href="{{ repository }}/releases">Releases</a></li>
                <li><a href="{{ repository }}/blob/main/SECURITY.md">Security</a></li>
                <li><a href="{{ repository }}/blob/{{ release ?? 'main' }}/LICENSE">MIT license</a></li>
            </ul>
        </div>
    </nav>
</footer>
</body>
</html>
