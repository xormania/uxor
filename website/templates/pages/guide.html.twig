{% extends 'base.html.twig' %}

{% set markdown_url = path('app_guide_markdown', {name: name}) %}
{% set page_title = title ~ ': ' ~ kit.manifest.name %}

{% block body %}
    <a class="guide-back" href="{{ path('app_index') }}#guides">All guides</a>
    <div class="guide-layout">
        {% if guide_toc|length > 1 %}
            {% set contents %}
                <ul>
                    {% for heading in guide_toc %}
                        <li><a href="#{{ heading.id }}">{{ heading.title }}</a></li>
                    {% endfor %}
                </ul>
            {% endset %}
            <nav class="guide-toc" aria-label="On this page">
                <details class="toc-disclosure">
                    <summary>On this page</summary>
                    {{ contents }}
                </details>
                <div class="toc-sidebar">
                    <p>On this page</p>
                    {{ contents }}
                </div>
            </nav>
        {% endif %}
        <article class="recipe-doc guide" data-testid="guide">
            {{ doc|raw }}
            <p class="resource-links">
                <a href="{{ markdown_url }}" type="text/markdown">This guide as Markdown</a>
                <a href="{{ repository }}/blob/{{ commit ?? ref }}/{{ file }}">View source on GitHub</a>
            </p>
        </article>
    </div>
{% endblock %}
