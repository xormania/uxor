    {
      "id": "historical-manual-marker",
      "command": [
        "bash",
        "--noprofile",
        "--norc",
        "-eo",
        "pipefail",
        "-c",
        "if [ \"$EVENT\" != schedule ]; then\n    echo \"run=true\" >> \"$GITHUB_OUTPUT\"\n    echo \"ref=\" >> \"$GITHUB_OUTPUT\"\n    exit 0\nfi\nhead=$(gh api \"repos/$REPO/commits/dev\" --jq .sha)\n# a run whose release checks passed uploads release-checks-passed-<the commit it tested>; only one of this\n# workflow, run on a schedule or by hand in this repository and ended in success, counts: an artifact of\n# that name from a pull request, a fork or another workflow proves nothing\npassed=0\nids=$(gh api \"repos/$REPO/actions/artifacts?name=release-checks-passed-$head&per_page=100\" \\\n    --jq '.artifacts[] | select(.expired | not) | select(.workflow_run.head_repository_id == .workflow_run.repository_id) | .workflow_run.id')\nfor id in $ids; do\n    if [ -n \"$(gh api \"repos/$REPO/actions/runs/$id\" --jq 'select(.path == \".github/workflows/release-checks.yml\" and (.event == \"schedule\" or .event == \"workflow_dispatch\") and .conclusion == \"success\") | .id')\" ]; then\n        passed=1\n        echo \"run $id passed the release checks on $head\"\n        break\n    fi\ndone\necho \"dev is at $head; a trusted pass on it: $passed\"\nif [ \"$passed\" = 1 ]; then\n    echo \"run=false\" >> \"$GITHUB_OUTPUT\"\n    echo \"Nothing was merged into dev since the release checks last passed on it: none today\" >> \"$GITHUB_STEP_SUMMARY\"\nelse\n    echo \"run=true\" >> \"$GITHUB_OUTPUT\"\nfi\necho \"ref=$head\" >> \"$GITHUB_OUTPUT\""
      ],
      "cwd": "/workspace/scratch/uxor-issue134-quality/red-proofs/target-main",
