{%- props
    ## 'rounded'|'pill' The badge shape.
    shape = 'pill'
-%}
{#- drop every attribute named on…: behavior goes through data-action, never an inline handler -#}
{%- set attributes = attributes.without(...attributes.all|keys|filter((name) => (name ~ '')|trim("\x00..\x20", 'left')|lower starts with 'on')) -%}
{%- set style = html_cva(
    base: 'animate-pulse motion-reduce:[animation-duration:6s]! bg-neutral-quaternary',
    variants: {
        shape: {
            rounded: 'rounded-base',
            pill: 'rounded-full',
        },
    },
) -%}
<div
    {{ attributes.defaults({
        class: style.apply({shape: shape})|tailwind_classes,
    }) }}
>
    {##- The content rendered inside the skeleton placeholder. -#}
    {%- block content %}{% endblock -%}
</div>
