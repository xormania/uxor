{%- props
    ## boolean Whether to hide the table borders.
    borderless = false
-%}
{#- drop every attribute named on…: behavior goes through data-action, never an inline handler -#}
{%- set attributes = attributes.without(...attributes.all|keys|filter((name) => (name ~ '')|trim("\x00..\x20", 'left')|lower starts with 'on')) -%}
<table
    data-border="{{ borderless ? 'borderless' : 'bordered' }}"
    {{ attributes.defaults({
        class: 'w-full text-sm text-left rtl:text-right text-body group/table'|tailwind_classes,
    }) }}
>
    {##- The table structure, typically includes `Table:Header`, `Table:Body`, and optionally `Table:Footer`. -#}
    {%- block content %}{% endblock -%}
</table>
