# The UX Toolkit installs a kit from GitHub's archive of the whole repository
# (archive/<version>.zip). Keep everything that is not part of the kit out of it.
/.github export-ignore
/demo export-ignore
/docs export-ignore
/tests export-ignore
/tools export-ignore
# xorder test runner config (named planted faults), repository tooling
/.xorder export-ignore
# Recipe tests (upstream specs, screenshot baselines) are not installed by ux:install
/*/tests export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/playwright.config.ts export-ignore
# Repository docs, not part of the kit
/CONTRIBUTING.md export-ignore
/CHANGELOG.md export-ignore
/AGENTS.md export-ignore
/SECURITY.md export-ignore
/FOR-AGENTS.md export-ignore
/llms.txt export-ignore
/.editorconfig export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
