{%- props
    ## 'default'|'invalid' The visual style variant.
    variant = 'default'
-%}
{#- drop every attribute named on…: behavior goes through data-action, never an inline handler -#}
{%- set attributes = attributes.without(...attributes.all|keys|filter((name) => (name ~ '')|trim("\x00..\x20", 'left')|lower starts with 'on')) -%}
{%- set style = html_cva(
    base: 'block text-sm font-medium',
    variants: {
        variant: {
            default: 'text-heading',
            invalid: 'text-fg-danger-strong',
        },
    },
) -%}
<label
    {{ attributes.defaults({
        class: style.apply({variant: variant})|tailwind_classes,
    }) }}
>
    {##- The label text for a form control. -#}
    {%- block content %}{% endblock -%}
</label>
