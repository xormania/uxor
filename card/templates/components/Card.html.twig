{# drop every attribute named on…: behavior goes through data-action, never an inline handler #}
{% set attributes = attributes.without(...attributes.all|keys|filter((name) => (name ~ '')|trim("\x00..\x20", 'left')|lower starts with 'on')) %}
<div
    {{ attributes.defaults({
        class: 'bg-neutral-primary-soft text-body block p-6 border border-default rounded-base shadow-xs'|tailwind_classes,
    }) }}
>
    {##- The card content, typically includes `Card:Content` with `Card:Header`, and/or `Card:Footer`. -#}
    {%- block content %}{% endblock -%}
</div>
