{# drop every attribute named on…: behavior goes through data-action, never an inline handler #}
{% set attributes = attributes.without(...attributes.all|keys|filter((name) => (name ~ '')|trim("\x00..\x20", 'left')|lower starts with 'on')) %}
<input
    type="checkbox"
    {{ attributes.defaults({
        class: 'w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft disabled:border-light accent-brand'|tailwind_classes,
    }) }}
>
