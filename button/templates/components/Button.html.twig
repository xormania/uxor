{%- props
    ## 'brand'|'secondary'|'tertiary'|'success'|'danger'|'warning'|'dark'|'ghost'|'outline'|'outline-brand'|'outline-success'|'outline-danger'|'outline-warning' The visual style variant.
    variant = 'brand',
    ## 'default'|'xs'|'sm'|'lg'|'xl'|'icon'|'icon-xs'|'icon-sm' The button size.
    size = 'default',
    ## 'rounded'|'pill' The badge shape.
    shape = 'rounded',
    ## 'button'|'a' The HTML tag to render; any other value renders a `button`.
    as = 'button',
    ## string|null The link when `as="a"`; a URL other than relative, http(s), mailto or tel renders `#`.
    href = null
-%}
{%- set as = as|lower in ['button', 'a'] ? as|lower : 'button' -%}
{#- Read links as browsers do: ignore leading spaces/C0 controls and tabs/newlines in a scheme. -#}
{%- set _href = href is not null ? ((href ~ '')|replace({"\t": '', "\n": '', "\r": ''})|trim("\x00..\x20", 'left') matches '/^(?:(?:https?|mailto|tel):|(?![a-z][a-z0-9+.-]*:))/i' ? href ~ '' : '#') : null -%}
{%- set style = html_cva(
    base: 'inline-flex items-center justify-center box-border border border-transparent font-medium focus:ring-4 focus:outline-none shadow-xs',
    variants: {
        variant: {
            brand: 'text-fg-on-brand bg-brand hover:bg-brand-strong focus:ring-brand-medium',
            secondary: 'text-body bg-neutral-secondary-medium border-default-medium hover:bg-neutral-tertiary-medium hover:text-heading focus:ring-neutral-tertiary',
            tertiary: 'text-body bg-neutral-primary-soft border-default hover:bg-neutral-secondary-medium hover:text-heading focus:ring-neutral-tertiary-soft',
            success: 'text-fg-on-success bg-success hover:bg-success-strong focus:ring-success-medium',
            danger: 'text-fg-on-danger bg-danger hover:bg-danger-strong focus:ring-danger-medium',
            warning: 'text-fg-on-warning bg-warning hover:bg-warning-strong focus:ring-warning-medium',
            dark: 'text-fg-on-dark bg-dark hover:bg-dark-strong focus:ring-neutral-tertiary',
            ghost: 'text-heading bg-transparent hover:bg-neutral-secondary-medium focus:ring-neutral-tertiary shadow-none',
            outline: 'text-body bg-neutral-primary border-default hover:bg-neutral-secondary-soft hover:text-heading focus:ring-neutral-tertiary',
            'outline-brand': 'text-fg-brand bg-neutral-primary border-brand hover:bg-brand hover:text-fg-on-brand focus:ring-brand-subtle',
            'outline-success': 'text-fg-success bg-neutral-primary border-success hover:bg-success hover:text-fg-on-success focus:ring-neutral-tertiary',
            'outline-danger': 'text-fg-danger bg-neutral-primary border-danger hover:bg-danger hover:text-fg-on-danger focus:ring-neutral-tertiary',
            'outline-warning': 'text-fg-warning bg-neutral-primary border-warning hover:bg-warning hover:text-fg-on-warning focus:ring-neutral-tertiary',
        },
        size: {
            default: 'leading-5 text-sm px-4 py-2.5',
            xs: 'leading-5 text-xs px-3 py-1.5',
            sm: 'leading-5 text-sm px-3 py-2',
            lg: 'text-base px-5 py-3',
            xl: 'text-base px-6 py-3.5',
            icon: 'w-10 h-10',
            'icon-xs': 'w-8 h-8',
            'icon-sm': 'w-9 h-9',
        },
        shape: {
            rounded: 'rounded-base',
            pill: 'rounded-full',
        },
    },
) -%}
<{{ as }}
    {%- if as == 'a' and _href is not null %} href="{{ _href }}"{% endif %}
    {{ attributes.defaults({
        class: style.apply({variant: variant, size: size, shape: shape})|tailwind_classes,
    }) }}
>
    {##- The button label and/or icon. -#}
    {%- block content %}{% endblock -%}
</{{ as }}>
