{
    "name": "xormania/uxor-development-app",
    "description": "Independent Symfony consumer used to develop and verify UXor's Composer package",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/stimulus-bundle": "^3.5.1",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-icons": "^3.5.1",
        "symfony/ux-live-component": "^3.5.1",
        "symfony/ux-turbo": "^3.5.1",
        "symfony/ux-twig-component": "^3.5.1",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/tailwind-bundle": "^1.0",
        "tales-from-a-dev/twig-tailwind-extra": "^1.5",
        "twig/extra-bundle": "^3.29",
        "twig/html-extra": "^3.29"
    },
    "require-dev": {
        "symfony/ai-symfony-mate-extension": "^0.14",
        "symfony/http-client": "7.4.*",
        "symfony/maker-bundle": "^1.64",
        "symfony/ux-toolkit": "3.5.1",
        "xormania/uxor": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../..",
            "options": {
                "symlink": true,
                "reference": "none",
                "versions": {
                    "xormania/uxor": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mate\\": "mate/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "symfony/ai-mate-composer-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "extra": {
        "ai-mate": {
            "extension": false,
            "scan-dirs": [
                "mate/src"
            ],
            "includes": [
                "mate/config.php"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
