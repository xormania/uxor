{# drop every attribute named on…: behavior goes through data-action, never an inline handler #}
{% set attributes = attributes.without(...attributes.all|keys|filter((name) => (name ~ '')|trim("\x00..\x20", 'left')|lower starts with 'on')) %}
<input
    type="radio"
    {{ attributes.defaults({
        class: 'w-4 h-4 text-neutral-primary border-default-medium bg-neutral-secondary-medium rounded-full checked:border-brand focus:ring-2 focus:outline-none focus:ring-brand-subtle border border-default appearance-none'|tailwind_classes,
    }) }}
>
