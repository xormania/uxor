
{%- props
    ## 'a'|'button' The item tag; any other value renders an `a`.
    as = 'a',
    ## string|null The link when `as="a"`; a URL other than relative, http(s), mailto or tel renders `#`.
    href = null
-%}
{%- set as = as|lower in ['a', 'button'] ? as|lower : 'a' -%}
{#- Read links as browsers do: ignore leading spaces/C0 controls and tabs/newlines in a scheme. -#}
{%- set _href = href is not null ? ((href ~ '')|replace({"\t": '', "\n": '', "\r": ''})|trim("\x00..\x20", 'left') matches '/^(?:(?:https?|mailto|tel):|(?![a-z][a-z0-9+.-]*:))/i' ? href ~ '' : '#') : null -%}

{% set _attributes_defaults = {} %}
{% if as == 'button' %}
    {% set _attributes_defaults = {type: 'button'} %}
{% endif %}

<li role="none">
    <{{ as }}
        role="menuitem"
        tabindex="-1"
        {%- if as == 'a' and _href is not null %} href="{{ _href }}"{% endif %}
        {{ attributes.defaults(_attributes_defaults).defaults({class: 'inline-flex items-center w-full p-2 text-sm font-medium text-body hover:bg-neutral-tertiary-medium hover:text-heading rounded'|tailwind_classes}) }}
    >
        {##- The item label. -#}
        {%- block content %}{% endblock -%}
    </{{ as }}>
</li>
