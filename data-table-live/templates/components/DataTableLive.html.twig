{#- The template of a table extending App\UXor\DataTableLive\AbstractLiveDataTable: name it in the subclass's
    #[AsLiveComponent(template: 'components/DataTableLive.html.twig')]. Its fields are plain elements with the classes
    of the Input, Select and Checkbox components: inside a Live Component, `data-model` on a Twig component binds a
    parent prop to it instead of rendering the attribute. -#}
{#- `this` means the nested component inside the content of the Table components below: name the table once. -#}
{%- set table = this -%}
{%- set view = table.view -%}
{%- set query = view.query -%}
{%- set id = table.tableId -%}
{#- The cell blocks render here, in the component's own scope: inside the content of the nested Table components below,
    block() would only see their blocks. -#}
{%- set cells = {} -%}
{%- for row in view.result.rows -%}
    {%- for column in view.table.columns -%}
        {##- A cell rendered by the page, named `cell_<column key>`, with `row` the current row; without it, the cell shows `row.<column key>`. -#}
        {%- if block('cell_' ~ column.key) is defined -%}
            {%- set cells = cells|merge({(view.table.rowId(row) ~ ':' ~ column.key): block('cell_' ~ column.key)}) -%}
        {%- endif -%}
    {%- endfor -%}
{%- endfor -%}
{#- data-table-live: leaving the page drops the selection, which Turbo's copy of the page would show again on Back -#}
<div {{ attributes.defaults({class: 'block'|tailwind_classes, 'data-controller': 'data-table-live', 'data-action': 'turbo:before-cache@document->data-table-live#cache'}) }}>
    <div class="mb-4 flex flex-wrap items-end gap-3" role="search" aria-label="{{ table.label ? table.label ~ ': search and filters' : 'Search and filters' }}">
        <div class="min-w-48 grow">
            <label for="{{ id }}-search" class="mb-1 block text-sm font-medium text-heading">Search</label>
            <input type="search" id="{{ id }}-search" value="{{ query.search }}" maxlength="100" class="{{ ('bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full shadow-xs placeholder:text-body [&:disabled:not([readonly])]:text-fg-disabled aria-invalid:bg-danger-soft aria-invalid:border-danger-subtle aria-invalid:text-fg-danger-strong aria-invalid:focus:ring-danger aria-invalid:focus:border-danger aria-invalid:placeholder:text-fg-danger-strong px-3 py-2.5')|tailwind_classes }}" data-model="debounce(300)|search">
        </div>
        {%- for filter in view.table.filters %}
            <div>
                <label for="{{ id }}-filter-{{ filter.key }}" class="mb-1 block text-sm font-medium text-heading">{{ filter.label }}</label>
                <select id="{{ id }}-filter-{{ filter.key }}" class="block w-full px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand shadow-xs placeholder:text-body disabled:text-fg-disabled aria-invalid:bg-danger-soft aria-invalid:border-danger-subtle aria-invalid:text-fg-danger-strong aria-invalid:focus:ring-danger aria-invalid:focus:border-danger" data-model="filterValues.{{ filter.key }}">
                    <option value="">All</option>
                    {%- for value, choice in filter.choices %}
                        <option value="{{ value }}"{{ (query.filters[filter.key] ?? null) is same as(value ~ '') ? ' selected' }}>{{ choice }}</option>
                    {%- endfor %}
                </select>
            </div>
        {%- endfor %}
        {%- if view.table.pageSizes|length > 1 %}
            <div>
                <label for="{{ id }}-size" class="mb-1 block text-sm font-medium text-heading">Rows per page</label>
                <select id="{{ id }}-size" class="block w-full px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand shadow-xs placeholder:text-body disabled:text-fg-disabled aria-invalid:bg-danger-soft aria-invalid:border-danger-subtle aria-invalid:text-fg-danger-strong aria-invalid:focus:ring-danger aria-invalid:focus:border-danger" data-model="pageSize">
                    {%- for size in view.table.pageSizes %}
                        <option value="{{ size }}"{{ size == query.pageSize ? ' selected' }}>{{ size }}</option>
                    {%- endfor %}
                </select>
            </div>
        {%- endif %}
    </div>

    {%- if table.selectable %}
        <div class="mb-3 flex flex-wrap items-center gap-3 text-sm">
            <p class="text-body" role="status">
                <span class="font-semibold text-heading">{{ table.selectedIds|length }}</span> selected
                {%- if table.isSelectionFull %}, the most this table selects{% endif -%}
            </p>
            {%- if not table.isSelectionFull %}
                <twig:Button type="button" variant="tertiary" size="xs" data-action="live#action" data-live-action-param="selectPage">Select this page</twig:Button>
            {%- endif %}
            {%- if table.selectedIds is not empty %}
                <twig:Button type="button" variant="tertiary" size="xs" data-action="live#action" data-live-action-param="clearSelection">Clear selection</twig:Button>
                {##- The actions on the selected rows, typically buttons calling the table's own #[LiveAction]s. -#}
                {%- block selection_actions %}{% endblock -%}
            {%- endif %}
        </div>
    {%- endif %}

    {%- if view.result.rows is empty %}
        <twig:EmptyState
            title="{{ view.isFiltered ? 'No matching rows' : 'Nothing here yet' }}"
            description="{{ view.isFiltered ? 'Change the search or the filters.' : null }}"
            class="rounded-base border border-default"
        />
    {%- else %}
        <div class="relative w-full overflow-x-auto rounded-base border border-default" data-loading="addClass(opacity-60)">
            <twig:Table {{ ...(table.label ? {'aria-label': table.label} : {}) }}>
                {%- if table.label %}
                    <twig:Table:Caption class="sr-only">{{ table.label }}</twig:Table:Caption>
                {%- endif %}
                <twig:Table:Header>
                    <twig:Table:Row>
                        {%- if table.selectable %}
                            <twig:Table:Head scope="col" class="w-4"><span class="sr-only">Selected</span></twig:Table:Head>
                        {%- endif %}
                        {%- for column in view.table.columns %}
                            {%- set sorted = column.key == query.sort -%}
                            <twig:Table:Head scope="col" {{ ...(sorted ? {'aria-sort': query.direction == 'asc' ? 'ascending' : 'descending'} : {}) }}>
                                {%- if column.isSortable() %}
                                    <button type="button" class="inline-flex items-center gap-1 font-medium text-heading hover:underline" data-action="live#action" data-live-action-param="sortBy" data-live-column-param="{{ column.key }}">
                                        {{- column.label -}}
                                        {%- if sorted %}
                                            <twig:ux:icon name="{{ query.direction == 'asc' ? 'flowbite:arrow-up-outline' : 'flowbite:arrow-down-outline' }}" class="size-3.5" aria-hidden="true" />
                                        {%- endif -%}
                                    </button>
                                {%- else %}
                                    {{- column.label -}}
                                {%- endif %}
                            </twig:Table:Head>
                        {%- endfor %}
                    </twig:Table:Row>
                </twig:Table:Header>
                <twig:Table:Body>
                    {%- for row in view.result.rows %}
                        {%- set row_id = view.table.rowId(row) -%}
                        <twig:Table:Row id="{{ id }}-row-{{ row_id }}">
                            {%- if table.selectable %}
                                <twig:Table:Cell class="w-4">
                                    <input type="checkbox" class="w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft disabled:border-light accent-brand" data-model="selectedIds[]" value="{{ row_id }}" aria-label="Select row {{ row_id }}"{{ table.isSelected(row) ? ' checked' : (table.isSelectionFull ? ' disabled') }}>
                                </twig:Table:Cell>
                            {%- endif %}
                            {%- for column in view.table.columns %}
                                <twig:Table:Cell>
                                    {%- set cell_key = row_id ~ ':' ~ column.key -%}
                                    {#- a cell block's output, already escaped when it rendered -#}
                                    {{- cell_key in cells|keys ? cells[cell_key]|raw : attribute(row, column.key) -}}
                                </twig:Table:Cell>
                            {%- endfor %}
                        </twig:Table:Row>
                    {%- endfor %}
                </twig:Table:Body>
            </twig:Table>
        </div>
    {%- endif %}

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-body" role="status">
            {%- if view.result.total > 0 -%}
                Showing <span class="font-semibold text-heading">{{ view.from }}–{{ view.to }}</span> of <span class="font-semibold text-heading">{{ view.result.total }}</span>
                {%- if view.isCapped %}; the first {{ view.table.maxRows }} can be paged through: search or filter to narrow them{% endif -%}
            {%- else -%}
                No rows
            {%- endif -%}
        </p>
        {%- if view.pageCount > 1 %}
            <twig:Pagination aria-label="{{ table.label ? table.label ~ ' pages' : 'Pages' }}">
                <twig:Pagination:Content>
                    {%- if query.page > 1 %}
                        <twig:Pagination:Item>
                            <twig:Pagination:Previous href="#" data-action="live#action:prevent" data-live-action-param="goTo" data-live-page-param="{{ query.page - 1 }}" />
                        </twig:Pagination:Item>
                    {%- endif %}
                    {%- for page in view.pageWindow %}
                        <twig:Pagination:Item>
                            {%- if page is null -%}
                                <span class="flex h-10 items-center px-3 text-sm text-body" aria-hidden="true">…</span>
                            {%- else -%}
                                <twig:Pagination:Link href="#" :active="page == query.page" aria-label="Page {{ page }}" data-action="live#action:prevent" data-live-action-param="goTo" data-live-page-param="{{ page }}">{{ page }}</twig:Pagination:Link>
                            {%- endif -%}
                        </twig:Pagination:Item>
                    {%- endfor %}
                    {%- if query.page < view.pageCount %}
                        <twig:Pagination:Item>
                            <twig:Pagination:Next href="#" data-action="live#action:prevent" data-live-action-param="goTo" data-live-page-param="{{ query.page + 1 }}" />
                        </twig:Pagination:Item>
                    {%- endif %}
                </twig:Pagination:Content>
            </twig:Pagination>
        {%- endif %}
    </div>
</div>
