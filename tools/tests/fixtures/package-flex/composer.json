{
    "name": "uxor/package-flex-consumer",
    "description": "Isolated PHP consumer exercising the real Symfony Flex lifecycle.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "xormania/uxor-pilot": "0.0.1",
        "symfony/flex": "2.11.0",
        "symfony/console": "8.1.8",
        "symfony/yaml": "8.1.8",
        "symfony/framework-bundle": "8.1.8",
        "symfony/twig-bundle": "8.1.7",
        "symfony/asset-mapper": "8.1.8",
        "symfony/asset": "8.1.0",
        "symfony/stimulus-bundle": "3.5.1",
        "symfony/ux-twig-component": "3.5.1",
        "symfony/ux-turbo": "3.5.1",
        "symfony/ux-icons": "3.5.1",
        "twig/twig": "3.30.0",
        "tales-from-a-dev/twig-tailwind-extra": "1.5.0"
    },
    "autoload": { "psr-4": { "Consumer\\": "src/" } },
    "config": { "allow-plugins": { "symfony/flex": true } }
}
