{
    "name": "uxor/package-flex-consumer",
    "description": "Isolated PHP consumer exercising the real Symfony Flex lifecycle.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "xormania/uxor-pilot": "0.0.1",
        "symfony/flex": "2.12.0",
        "symfony/console": "8.1.11",
        "symfony/yaml": "8.1.11",
        "symfony/framework-bundle": "8.1.11",
        "symfony/twig-bundle": "8.1.9",
        "symfony/asset-mapper": "8.1.11",
        "symfony/asset": "8.1.0",
        "symfony/stimulus-bundle": "3.7.0",
        "symfony/ux-twig-component": "3.7.0",
        "symfony/ux-turbo": "3.6.0",
        "symfony/ux-icons": "3.7.0",
        "twig/twig": "3.30.0",
        "tales-from-a-dev/twig-tailwind-extra": "1.5.0"
    },
    "autoload": {
        "psr-4": {
            "Consumer\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
