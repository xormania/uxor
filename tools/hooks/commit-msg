#!/bin/sh
# Refuses a commit message that names a GitHub account or team not in .github/mention-allowlist
# (tools/check-github-mentions.mjs; CONTRIBUTING.md, *Commits and pull requests*). Install once per clone:
#   git config core.hooksPath tools/hooks
root=$(git rev-parse --show-toplevel) || exit 1
# The whole message is checked, comment lines included: git keeps a line starting with # when the message is not
# edited (`git commit -m`), and the hook cannot tell which cleanup mode applies. Only the diff of `git commit -v`,
# below the scissors line, is left out: git always drops it.
sed '/^# -\{24\} >8 -\{24\}$/,$d' "$1" | node "$root/tools/check-github-mentions.mjs" --allow-file "$root/.github/mention-allowlist" --surface commit-message
