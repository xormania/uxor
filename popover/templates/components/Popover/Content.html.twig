{%- props
    ## string|null The dialog's accessible name. Without it, the trigger's text names the dialog.
    label = null
-%}
{#- the attributes given, in any case: no `on…` handler, `srcset` or `ping`; `href` and `formaction` through the link policy, `src` through the image policy -#}
{%- set attributes = attributes.without(...attributes.all|keys).defaults(attributes.all|filter((value, name) => not ((name ~ '')|trim("\x00..\x20", 'left')|lower matches '/^(?:on|(?:srcset|ping)$)/'))|map((value, name) => (name ~ '')|trim("\x00..\x20", 'left')|lower not in ['href', 'formaction', 'src'] or value is null or value is same as(false) or value is same as(true) ? value : ((value ~ '')|replace({"\t": '', "\n": '', "\r": ''})|trim("\x00..\x20", 'left') matches ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? '/^(?:https?:|(?![a-z][a-z0-9+.-]*:))/i' : '/^(?:(?:https?|mailto|tel):|(?![a-z][a-z0-9+.-]*:))/i') ? value ~ '' : ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? null : '#')))) -%}
{%- set _popover_id = inject('popover.id') -%}
{%- set _popover_open = inject('popover.open', false) -%}
<div
    id="{{ _popover_id }}-content"
    role="dialog"
    tabindex="-1"
    {% if label is not null %}aria-label="{{ label }}"{% else %}aria-labelledby="{{ _popover_id }}-trigger"{% endif %}
    data-popover-target="content"
    data-state="{{ _popover_open ? 'open' : 'closed' }}"
    {% if not _popover_open %}hidden{% endif %}
    {{ attributes.defaults({
        class: 'z-10 w-72 rounded-base border border-default-medium bg-neutral-primary-medium p-4 text-sm text-body shadow-lg outline-none'|tailwind_classes,
    }) }}
>
    {##- What the popover shows: text, links, a small form. -#}
    {%- block content %}{% endblock -%}
</div>
